# Copy to .env.local for local dev; set the same variables in your host's dashboard.

# Web3Forms access key for the contact form (free at https://web3forms.com —
# enter your email, the key arrives instantly). Publishable; safe to expose.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL used by SEO tags, sitemap and robots (set after deploying).
NEXT_PUBLIC_SITE_URL=
